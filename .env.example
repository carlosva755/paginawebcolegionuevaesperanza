# ==============================================================================
# ENVIRONMENT VARIABLES - EARLY WARNING AND SCHOOL ACCOMPANIMENT PLATFORM
# Institución Educativa Distrital Nueva Esperanza - Soacha
# ==============================================================================

# Environment profile
NODE_ENV=development
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL Database (Single server hosting 2 isolated logical databases)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_secure_pass_2026

# Microservice 1: Alertas (C# .NET 8)
ALERTAS_DB_NAME=alertas_db
ALERTAS_PORT=5001
ALERTAS_CONNECTION_STRING=Host=postgres;Port=5432;Database=alertas_db;Username=postgres;Password=postgres_secure_pass_2026;

# Microservice 2: Acompañamiento (Node.js)
ACOMPANAMIENTO_DB_NAME=acompanamiento_db
ACOMPANAMIENTO_PORT=5002
ACOMPANAMIENTO_DB_URI=postgres://postgres:postgres_secure_pass_2026@postgres:5432/acompanamiento_db

# Security & JWT (Shared symmetric secret for decentralized token validation)
JWT_SECRET=ClaveSecretaSuperSeguraParaJWTEnNuevaEsperanzaSoacha2026Minimo32Caracteres!
JWT_ISSUER=NuevaEsperanzaAuthServer
JWT_AUDIENCE=NuevaEsperanzaPlatform
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# Frontend SPA (Vite)
VITE_ALERTAS_API_URL=http://localhost:5001/api/v1
VITE_ACOMPANAMIENTO_API_URL=http://localhost:5002/api/v1
FRONTEND_PORT=3000
